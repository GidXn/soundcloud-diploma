{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "your_jwt_secret_key_here_at_least_32_characters_long",
    "Issuer": "soundcloud-back",
    "Audience": "soundcloud-back",
    "ExpiryMinutes": 60
  },
  "GoogleAuth": {
    "ClientId": "your_google_client_id_here.apps.googleusercontent.com"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=your_database_host;Database=your_database_name;Username=your_database_username;Password=your_database_password;"
  },
  "AllowedHosts": "*"
}
